# ==========================================
# KONFIGURASI BOT REKAP NILAI CBT
# SMP Hang Tuah 5 Sidoarjo
# ==========================================

# 1. Token Bot Telegram (Didapat dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=isi_token_bot_telegram_disini

# 2. Alamat Link URL Server CBT (tanpa tanda garis miring / di akhir)
CBT_URL=https://cbt.sekolahanda.sch.id

# 3. Username / Email & Password Login Admin CBT
CBT_EMAIL=admin_cbt@sekolah.sch.id
CBT_PASSWORD=isi_password_admin_cbt_disini

# 4. (Opsional) Integrasi n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/rekap-nilai
N8N_API_KEY=

# 5. (Opsional) Akun Uji Coba yang Dikecualikan dari Rekap & Susulan (pisahkan dengan koma)
EXCLUDED_USERS=coba7,coba8,coba9

# 6. (Opsional) Chat ID atau ID Grup Telegram untuk Siaran Notifikasi Otomatis Ujian Selesai (pisahkan dengan koma)
NOTIF_CHAT_ID=


